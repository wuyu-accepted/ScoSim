{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuspulse.local/schemas/campuspulse-assimilation-sidecar-v1.0.0.schema.json",
  "title": "CampusPulse native action assimilation audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assimilation_sidecar_id", "case_id", "source_record_id",
    "assimilation_version", "decision_projection", "decision_sha256", "prompt_sha256",
    "before_state", "after_state", "before_particles_sha256", "after_particles_sha256",
    "after_particles", "after_particle_weights", "innovation_id", "resampled",
    "minimum_parent_ess", "trust_delta", "satisfaction_delta", "urgency", "evidence_status"
  ],
  "properties": {
    "schema_version": {"const": "campuspulse-assimilation-sidecar-v1.0.0"},
    "assimilation_sidecar_id": {"type": "string", "pattern": "^assim-[0-9a-f]{24}$"},
    "case_id": {"type": "string", "pattern": "^d2-[0-9a-f]{24}$"},
    "source_record_id": {"type": "string", "minLength": 1},
    "assimilation_version": {"const": "campuspulse-action-assimilation-v1.0.0"},
    "decision_projection": {"$ref": "#/$defs/decision_projection"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "before_state": {"$ref": "#/$defs/state"},
    "after_state": {"$ref": "#/$defs/state"},
    "before_particles_sha256": {"$ref": "#/$defs/sha256"},
    "after_particles_sha256": {"$ref": "#/$defs/sha256"},
    "after_particles": {"type": "array", "items": {"$ref": "#/$defs/state"}, "minItems": 10, "maxItems": 10},
    "after_particle_weights": {"type": "array", "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}, "minItems": 10, "maxItems": 10},
    "innovation_id": {"$ref": "#/$defs/sha256"},
    "resampled": {"type": "boolean"},
    "minimum_parent_ess": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 10.0},
    "trust_delta": {"type": "number", "minimum": -1.0, "maximum": 1.0},
    "satisfaction_delta": {"type": "number", "minimum": -1.0, "maximum": 1.0},
    "urgency": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "evidence_status": {"enum": ["unverified", "verified", "corrected", "contested", "service_receipt"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention", "concern", "trust", "satisfaction", "support", "opposition", "activity", "voice", "service_strain", "rumor_belief", "verified_belief", "evidence_acceptance"],
      "properties": {
        "attention": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "concern": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "trust": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "satisfaction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "support": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "opposition": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "activity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "voice": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "service_strain": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "rumor_belief": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "verified_belief": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence_acceptance": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      }
    },
    "decision_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "stance", "urgency", "trust_delta", "satisfaction_delta", "confidence", "evidence_status"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "stance": {"enum": ["support", "oppose", "uncertain"]},
        "urgency": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "trust_delta": {"const": 0.0},
        "satisfaction_delta": {"const": 0.0},
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "evidence_status": {"const": "unverified"}
      }
    }
  }
}
